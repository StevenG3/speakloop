{
  "name": "speakloop",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "predev": "pnpm validate:env",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
